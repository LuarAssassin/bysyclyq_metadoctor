# PostgreSQL
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=your_database_port

# Auth
AUTH_TOKEN_EXPIRE_DAYS=30

# CORS (dev can use *, production should prefer same-origin via Nginx /api proxy)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# Optional one-time doctor seed (used by: make seed-doctor)
DOCTOR_PHONE=13800000000
DOCTOR_EMAIL=
DOCTOR_PASSWORD=change_me_doctor_password
DOCTOR_NAME=杨院长
DOCTOR_TITLE=
DOCTOR_HOSPITAL=
DOCTOR_DEPT=
DOCTOR_BIO=

# Moonshot AI
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL_ID=kimi-k2.5
MOONSHOT_API_KEY=your_moonshot_api_key

# Redis
REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_PASSWORD=your_redis_password

# Aliyun DashScope
DASHSCOPE_REGION=cn
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key
PROMPT_DIR=prompts
QWEN_LONG_MODEL=qwen-long
QWEN_DOC_MODEL=qwen-doc-turbo
QWEN_RESPONSES_BASE_URL=https://dashscope.aliyuncs.com/api/v2/apps/protocols/compatible-mode/v1
QWEN_NARRATIVE_MODEL=qwen3-max-2026-01-23
QWEN_NARRATIVE_TIMEOUT_SECONDS=60
QWEN_NARRATIVE_OPTIMIZER_ENABLED=true
QWEN_REHEARSAL_SELECTOR_MODEL=qwen3-max-2026-01-23
QWEN_REHEARSAL_LONG_MODEL=qwen-long
QWEN_REHEARSAL_ANSWER_MODEL=qwen-max-latest
QWEN_REHEARSAL_HISTORY_LIMIT=12
QWEN_REHEARSAL_SEARCH_STRATEGY=max
QWEN_REHEARSAL_FORCED_SEARCH=true
QWEN_REHEARSAL_ENABLE_CITATION=true
QWEN_VOICE_ENROLL_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization
QWEN_TTS_REALTIME_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DIGITAL_HUMAN_TTS_TARGET_MODEL=qwen3-tts-vc-realtime-2026-01-15
DIGITAL_HUMAN_I2V_MODEL=wan2.6-i2v-flash
DIGITAL_HUMAN_I2V_RESOLUTION=720P
DIGITAL_HUMAN_I2V_DURATION=5
DIGITAL_HUMAN_I2V_GENERATE_COUNT=5
DIGITAL_HUMAN_I2V_MAX_GENERATE_COUNT=5
DIGITAL_HUMAN_DEFAULT_VOICE=longanyang
OSS_SIGNED_URL_EXPIRE_SECONDS=900
KNOWLEDGE_EXTRACT_QUEUE_KEY=mdapi:knowledge_extract_queue
KNOWLEDGE_EXTRACT_DELAYED_QUEUE_KEY=mdapi:knowledge_extract_queue:delayed
KNOWLEDGE_EXTRACT_MAX_RETRIES=2
KNOWLEDGE_EXTRACT_WORKER_POLL_TIMEOUT=5
KNOWLEDGE_EXTRACT_RETRY_DELAY_SECONDS=30
KNOWLEDGE_EXTRACT_PARSING_RETRY_DELAY_SECONDS=90

# Alibaba Cloud OSS
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_REGION=your_region
OSS_PUBLIC_BASE_URL=your_oss_public_url

# Lingmou AI
LINGMOU_ENDPOINT=your_lingmou_endpoint
LINGMOU_PROJECT_ID=your_project_id
LINGMOU_INSTANCE_ID=your_instance_id
LINGMOU_PLATFORM=Web


# Cloudflare 配置
# Cloudflare Realtime SFU
CLOUDFLARE_APP_ID=your_cloudflare_app_id
CLOUDFLARE_APP_SECRET=your_cloudflare_app_secret
CLOUDFLARE_TURN_KEY_ID=your_turn_key_id
CLOUDFLARE_TURN_KEY_API_TOKEN=your_turn_key_api_token
# R2 对象存储
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name
CLOUDFLARE_R2_ENDPOINT=your_r2_endpoint
CLOUDFLARE_R2_PUBLIC_URL=your_r2_public_url
# 无服务器 SFU 服务
SFU_APP_NAME=your_sfu_app_name
SFU_APP_ID=your_sfu_app_id
SFU_API_KEY=your_sfu_api_key

# DeepSeek AI
DEEPSEEK_BASE_URL=https://api.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key

# 腾讯云邮件服务配置
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_REGION=your_region
TENCENT_FROM_EMAIL=your_from_email
TENCENT_TEMPLATE_ID=your_template_id

# 腾讯云短信服务配置
TENCENT_CLOUD_SMS_SECRET_ID=your_secret_id
TENCENT_CLOUD_SMS_SECRET_KEY=your_secret_key
TENCENT_CLOUD_SMS_APP_ID=your_sms_app_id
TENCENT_CLOUD_SMS_SIGN_NAME=your_sign_name
TENCENT_CLOUD_SMS_TEMPLATE_ID=your_template_id

# OAuth providers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
